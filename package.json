{
  "name": "dsh-workspace-capabilities",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: choose which skills and MCP servers each workspace may use, from the workspace row's \"...\" menu.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fleey/dsh-workspace-capabilities.git"
  },
  "homepage": "https://github.com/Fleey/dsh-workspace-capabilities#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "mcp",
    "workspace"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
